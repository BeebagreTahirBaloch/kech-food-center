{
  "rewrites": [
    {"source":"/get-app","destination":"/index.html"},
    {"source":"/cart","destination":"/index.html"},
    {"source":"/orders","destination":"/index.html"},
    {"source":"/track/:id","destination":"/index.html"},
    {"source":"/admin","destination":"/index.html"},
    {"source":"/admin/orders","destination":"/index.html"},
    {"source":"/admin/riders","destination":"/index.html"},
    {"source":"/admin/settings","destination":"/index.html"},
    {"source":"/admin/history","destination":"/index.html"},
    {"source":"/rider","destination":"/index.html"}
  ],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), payment=(), usb=(), geolocation=(self), screen-wake-lock=(self)"},
      {"key":"Cross-Origin-Opener-Policy","value":"same-origin"},
      {"key":"Content-Security-Policy","value":"frame-ancestors 'none'; object-src 'none'; base-uri 'self'"},
      {"key":"Content-Security-Policy-Report-Only","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net; img-src 'self' data: blob: https://zsangbpeyefwovceierd.supabase.co https://*.tile.openstreetmap.org; connect-src 'self' https://zsangbpeyefwovceierd.supabase.co wss://zsangbpeyefwovceierd.supabase.co; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"}
    ]},
    {"source":"/notifications-sw.js","headers":[{"key":"Cache-Control","value":"no-cache"},{"key":"Service-Worker-Allowed","value":"/"}]},
    {"source":"/customer.webmanifest","headers":[{"key":"Content-Type","value":"application/manifest+json"},{"key":"Cache-Control","value":"no-cache"}]},
    {"source":"/owner.webmanifest","headers":[{"key":"Content-Type","value":"application/manifest+json"},{"key":"Cache-Control","value":"no-cache"}]},
    {
      "source": "/rider-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/rider"
        }
      ]
    },
    {
      "source": "/rider.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
